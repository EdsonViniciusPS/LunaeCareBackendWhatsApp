# Configurações do Ambiente
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Segurança e Autenticação
# Chave interna para comunicação entre os microsserviços Lunae Care
INTERNAL_API_KEY=lunae_internal_secret_change_me
# Segredo para autenticação dos webhooks do provedor
WEBHOOK_SECRET=lunae_webhook_secret_change_me

# JWT emitido pelo Lunae Care (mesmo segredo/issuer/audience do sistema de autenticação)
JWT_SECRET=lunae_jwt_secret_change_me_please_32b
JWT_ALGORITHM=HS256
JWT_ISSUER=lunaecare
JWT_AUDIENCE=lunaecare-whatsapp
JWT_CLINIC_CLAIM=clinic_id

# Chave de criptografia de credenciais em repouso (mantenha fora do banco)
ENCRYPTION_KEY=lunae_encryption_key_change_me

# Banco de Dados PostgreSQL (asyncpg)
DATABASE_URL=postgresql+asyncpg://lunae_user:lunae_password@whatsapp-db:5432/lunaecare_whatsapp
# URL síncrona para Alembic (migrations)
DATABASE_SYNC_URL=postgresql+psycopg2://lunae_user:lunae_password@whatsapp-db:5432/lunaecare_whatsapp

# Redis (Fila e Tarefas assíncronas)
REDIS_URL=redis://whatsapp-redis:6379/0

# Provedor WhatsApp (Evolution API)
WHATSAPP_PROVIDER=evolution
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=evolution_global_api_key_change_me
EVOLUTION_WEBHOOK_URL=http://lunaecare-whatsapp:8000/api/v1/whatsapp/webhooks/evolution
# Modo Mock para testes locais sem instância da Evolution API rodando
EVOLUTION_MOCK_MODE=false
