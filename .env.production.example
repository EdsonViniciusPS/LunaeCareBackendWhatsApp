# ==============================================================================
# Lunae Care - Configurações de Produção (Hostinger VPS Ubuntu)
# ==============================================================================
# Copie este arquivo para .env na raiz do projeto na VPS:
#   cp .env.production.example .env
# Em seguida, substitua TODOS os segredos gerando novas chaves seguras:
#   openssl rand -hex 32
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurações Globais da Aplicação
# ------------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
PORT=8000
HOST=0.0.0.0

# Bind address para o host:
# 127.0.0.1 garante que a porta 8000 NÃO fique exposta diretamente à internet pública,
# sendo acessível apenas pelo Nginx reverso local com SSL HTTPS.
API_BIND_ADDRESS=127.0.0.1

# Quantidade de workers Uvicorn (recomendado: 2 para VPS 2 vCPUs, 4 para VPS 4 vCPUs)
WEB_CONCURRENCY=2

# Domínios permitidos no CORS (separados por vírgula)
CORS_ORIGINS=https://app.lunaecare.com.br

# ------------------------------------------------------------------------------
# 2. Segurança, Chaves Internas e Criptografia
# ATENÇÃO: Se qualquer chave abaixo contiver os valores padrão 'change_me',
# a aplicação abortará imediatamente no startup para proteger os dados médicos.
# ------------------------------------------------------------------------------

# Chave secreta compartilhada entre o backend central do Lunae Care e este microsserviço
# Gere com: openssl rand -hex 32
INTERNAL_API_KEY=substitua_com_openssl_rand_hex_32

# Segredo para autenticação HMAC dos webhooks de status/eventos do provedor
# Gere com: openssl rand -hex 32
WEBHOOK_SECRET=substitua_com_openssl_rand_hex_32

# Chave simétrica para assinatura dos tokens JWT das clínicas Lunae Care
# Deve ser idêntica à chave JWT_SECRET configurada no serviço de autenticação principal
JWT_SECRET=substitua_com_o_mesmo_segredo_jwt_do_lunae_care_32b
JWT_ALGORITHM=HS256
JWT_ISSUER=lunaecare
JWT_AUDIENCE=lunaecare-whatsapp
JWT_CLINIC_CLAIM=clinic_id

# Chave de criptografia simétrica para segredos e tokens sensíveis em repouso no banco (Fernet)
# Gere com: openssl rand -hex 32
ENCRYPTION_KEY=substitua_com_openssl_rand_hex_32

# ------------------------------------------------------------------------------
# 3. Banco de Dados PostgreSQL (Interno Docker)
# ------------------------------------------------------------------------------
POSTGRES_USER=lunae_user
# Gere uma senha forte com: openssl rand -hex 24
POSTGRES_PASSWORD=substitua_com_uma_senha_forte_do_postgres
POSTGRES_DB=lunaecare_whatsapp

# URLs de conexão da aplicação (substitua a senha abaixo pela mesma senha acima)
DATABASE_URL=postgresql+asyncpg://lunae_user:substitua_com_uma_senha_forte_do_postgres@whatsapp-db:5432/lunaecare_whatsapp
DATABASE_SYNC_URL=postgresql+psycopg2://lunae_user:substitua_com_uma_senha_forte_do_postgres@whatsapp-db:5432/lunaecare_whatsapp

# ------------------------------------------------------------------------------
# 4. Redis (Fila de Mensageria e Rate Limiting Sliding Window)
# ------------------------------------------------------------------------------
REDIS_URL=redis://whatsapp-redis:6379/0

# Intervalo em segundos do agendador periódico de lembretes devidos
SCHEDULER_INTERVAL_SECONDS=60

# ------------------------------------------------------------------------------
# 5. Provedor WhatsApp (Evolution API v2.2.2 Interno)
# ------------------------------------------------------------------------------
WHATSAPP_PROVIDER=evolution
EVOLUTION_API_URL=http://evolution-api:8080

# Chave global da Evolution API
# Gere com: openssl rand -hex 32
EVOLUTION_API_KEY=substitua_com_openssl_rand_hex_32

# Webhook chamado internamente pela Evolution API de volta ao Lunae Care
EVOLUTION_WEBHOOK_URL=http://lunaecare-whatsapp:8000/api/v1/whatsapp/webhooks/evolution

# Modo Mock DESATIVADO em produção
EVOLUTION_MOCK_MODE=false
